# Copy to .env and fill in. Never commit .env. All values are optional for
# `python -m ddhelper dry-run ...`; DISCORD_TOKEN and DISCORD_GUILD_ID are required for `run`.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Channel for sales + floor-move alerts (leave empty to disable alerts)
ALERT_CHANNEL_ID=
# Channel for the scheduled daily digest (leave empty to disable)
DIGEST_CHANNEL_ID=

# --- X API v2 (app-only bearer token, read-only). Without it the digest notes the gap. ---
X_BEARER_TOKEN=
X_ACCOUNTS=doginaldogs,barkmeta,DDLTCG,DDSalesBot
# Accounts whose posts are only included if they match a keyword (or are a Space link)
X_FILTERED_ACCOUNTS=barkmeta
X_FILTER_KEYWORDS=doginal,ddl,legends,ddmiami,pack,space,wizzy,woof

# --- Polling (seconds, minimum 60). Be polite: default 5 minutes. ---
SALES_POLL_SECONDS=300
FLOOR_POLL_SECONDS=300

# --- Floor-move alerts: fire when the floor moves >= FLOOR_ALERT_PCT percent AND
# >= FLOOR_ALERT_MIN_DOGE from the last alerted level, at most once per cooldown. ---
FLOOR_ALERT_PCT=10
FLOOR_ALERT_MIN_DOGE=2000
FLOOR_ALERT_COOLDOWN_SECONDS=3600
SALES_ALERT_MAX_PER_CYCLE=5

# --- Digest ---
DIGEST_TIME=09:00
DDHELPER_TZ=America/New_York
EVENTS_FILE=config/events.toml

# --- Cards: "official" (ddltcg.com/data/cards.json) or "local" (CARD_FILE) ---
CARD_SOURCE=official
CARD_FILE=

# --- Misc ---
DDHELPER_DB=data/ddhelper.sqlite3
HTTP_TIMEOUT_SECONDS=15
# DDHELPER_USER_AGENT=ddhelper/0.1.0 (Doginal Dogs community helper bot; read-only; +https://x.com/1nternot)
